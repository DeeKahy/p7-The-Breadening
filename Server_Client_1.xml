	<declaration>// Place global declarations here.
const int N = 3;                    // Number of clients
const int MAX_ID = N;


chan req[N], grant[N], done[N];
int queue[N];
int head = 0, tail = -1, qsize = 0;
int next_c_id;
typedef int [0,N-1] ID;
ID c_id;

int i = 1;
int dequeue(int N) {
    int first = queue[0];
    for (i = 1; i &lt; N; i++) {
        queue[i - 1] = queue[i];
    }
    tail = (tail+N-1) % N;
    if (qsize &gt;=2)
        queue[qsize-1] = 0;  // optional "clear"
    return first;
}

bool contains(int queue[N], ID c_id) {
    for (i = 0; i &lt; qsize; i++) { //check if ID is already in the queue
        int idx = (head + i) % N;
        if(queue[idx] == c_id)
            return true;
    }
    return false;
}

bool enqueue(int N, ID c_id) {
    if(qsize == N)
        return false;
    if(contains(queue, c_id))
        return false;
    tail = (tail+1) % N;
    queue[tail] = c_id;
    qsize++;
    return true;
}

int front(int queue[N], int N){
    if(qsize == 0)    //check if the queue is empty
        return -1;
    return queue[head];
}
</declaration>
