	<template>
		<name x="5" y="5">Process</name>
		<parameter>const int id, const int N</parameter>
		<declaration>// Place local declarations here.
clock x;

int processes[N] = {0,1,2,3,4};
bool sent_message[N];
int messages_left;
int next_reciever = 0;

int recieved_from_id;
int recieved_request_type;

int leader = -1;
bool shut_up = false;

void ready_electing_messages() {
    int i;
    messages_left = N;
    for(i=0; i &lt; N; i++) {
        sent_message[i] = false;
        /*if(processes[i] == id) {
            messages_left -= 1;
            sent_message[i] = true;
        } else {
            sent_message[i] = false;
        }*/
    }
}

void ready_shut_up_messages() {
    int i;
    messages_left = N;
    for(i=0; i&lt;N; i++) {
        if(processes[i] &lt;= id) {
            messages_left -= 1;
            sent_message[i] = true;
        } else {
            sent_message[i] = false;
        }
    }
}

void get_next_reciever() {
    if(next_reciever == N-1) {
        next_reciever = 0;
    } else {
        next_reciever += 1;
    }
}</declaration>
