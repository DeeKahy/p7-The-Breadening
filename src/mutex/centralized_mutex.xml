		<declaration>const int MAX1 = 1;  // used to check that qsize &lt;= 1
const int MIN2 = 2;  // used to check that qsize &gt;= 2
const int MAX0 = 3;  // used to check that qsize &lt;= 0
const int MIN1 = 4;  // used to check that qsize &gt;= 1

typedef struct{
    int queue[N];
    int head;
    int tail;
    int qsize;
} Server;

Server server = {{0, 0, 0}, 0, -1, 0};     // holds waiting client IDs

bool contains(int c_id) {
    int i;
    for (i = 0; i &lt; server.qsize; i++) {
        int idx = (server.head + i) % N;
        if(server.queue[idx] == c_id)
            return true;
    } 
    return false;
  }

void enqueue(int c_id) {
    server.tail = (server.tail + 1) % N;
    server.queue[server.tail] = c_id;
    server.qsize++;
}

void dequeue() {
    server.head = (server.head + 1) % N;
    server.qsize--;
}

int grant_client()
  {
    return granted_c_id = server.queue[server.head];
}

bool isOccupied(int mode) {
    if (mode == MAX1)
        return server.qsize &lt;= 1;    // qsize not larger than 1
    else if (mode == MIN2)
        return server.qsize &gt;= 2;    // qsize not less than 2
    else if (mode == MAX0)
        return server.qsize &lt;= 0;    // qsize not larger than 0
    else if (mode == MIN1)
        return server.qsize &gt;= 1;    // qsize not less than 1
    else
        return false;         // safety fallback
}</declaration>
