	<template>
		<name x="5" y="5">Server</name>
		<parameter>const int N</parameter>
		<declaration>int  queue[N];     // holds waiting client IDs
int  head  =  0;   // index of the oldest element
int  tail  = -1;   // index of the newest element
int  qsize =  0;   // current number of stored IDs

bool contains(int c_id) {
    int i;
    for (i = 0; i &lt; qsize; i++) {
        int idx = (head + i) % N;
        if(queue[idx] == c_id) return true;
    }
    return false;
  }

void enqueue(int c_id) {
    tail = (tail + 1) % N;
    queue[tail] = c_id;
    qsize++;
}

void dequeue() {
    head = (head + 1) % N;
    qsize--;
}

int front()
  {
    return queue[head];
}</declaration>
